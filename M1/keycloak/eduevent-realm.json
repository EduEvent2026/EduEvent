{
  "realm": "eduevent",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator"
      },
      {
        "name": "user",
        "description": "Zwykły użytkownik"
      }
    ]
  },
  "clients": [
    {
      "clientId": "eduevent-frontend",
      "name": "EduEvent frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8000/docs/oauth2-redirect",
        "http://127.0.0.1:8000/docs/oauth2-redirect"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8000",
        "http://127.0.0.1:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "authorizationServicesEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "eduevent-backend",
      "name": "EduEvent backend (Admin REST API)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "eduevent-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "admin.test",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.test@example.com",
      "firstName": "Admin",
      "lastName": "Testowy",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ]
    },
    {
      "username": "user.test",
      "enabled": true,
      "emailVerified": true,
      "email": "user.test@example.com",
      "firstName": "Jan",
      "lastName": "Kowalski",
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "service-account-eduevent-backend",
      "enabled": true,
      "serviceAccountClientId": "eduevent-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ]
}
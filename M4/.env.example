# Baza danych MySQL (dedykowana baza logiczna dla Modułu 4)
DATABASE_URL=mysql+pymysql://eduevent:eduevent@localhost:3306/eduevent_registrations

# Adresy pozostałych mikroserwisów (komunikacja wyłącznie przez REST API)
EVENTS_API_URL=http://events:8002
AUTH_API_URL=http://auth:8001
NOTIFICATIONS_API_URL=http://notifications:8007
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/eduevent/protocol/openid-connect/certs

# Tryb developerski (ułatwia testy zanim powstaną Moduły 1, 2 i 7)
# Ustaw na false przy pełnej integracji w Dockerze
DEV_MOCK_EXTERNAL_APIS=true
DEV_AUTH_BYPASS=true
DEV_DEFAULT_EVENT_CAPACITY=2